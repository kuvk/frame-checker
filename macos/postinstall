# Check if running on Apple Silicon
if sysctl -n machdep.cpu.brand_string | grep -q "Apple"; then
    IS_ARM64=true
else
    IS_ARM64=false
fi

# Restart script in ARM64 mode if running under Rosetta
if [[ $IS_ARM64 == true ]] && [[ $(sysctl -in sysctl.proc_translated) == "1" ]]; then
    echo "Restarting script in native ARM mode..."
    exec arch -arm64 "$0" "$@"
fi

TITLE="Frame Checker Installer"
INSTALL_SCRIPT="/tmp/install_ffmpeg.sh"
APP_SOURCE="/tmp/Frame Checker.app"
APP_DEST="/Applications/Frame Checker.app"

cleanup_and_exit() {
    echo "Cleaning up..."
    rm -rf "$INSTALL_SCRIPT"
    rm -rf "$APP_SOURCE"
    exit "$1"
}

if [[ ! -d "$APP_SOURCE" ]]; then
    echo "❌ Application bundle not found: $INSTALL_SCRIPT"
    osascript -e "tell application \"System Events\" to display dialog \"Error: Application bundle not found!\" with title \"$TITLE\" buttons {\"OK\"} default button \"OK\""
    cleanup_and_exit 1
fi

if [[ ! -f "$INSTALL_SCRIPT" ]]; then
    echo "❌ Install script not found: $INSTALL_SCRIPT"
    osascript -e "tell application \"System Events\" to display dialog \"Error: Install script not found!\" with title \"$TITLE\" buttons {\"OK\"} default button \"OK\""
    cleanup_and_exit 1
fi

# Install Application
echo "Moving Frame Checker.app to /Applications..."
mv "$APP_SOURCE" "$APP_DEST"

if [[ ! -d "$APP_DEST" ]]; then
    echo "❌ Cannot move $APP_SOURCE to $APP_DEST"
    osascript -e "tell application \"System Events\" to display dialog \"Error: Cannot move Frame Checker.app to Applications\" with title \"$TITLE\" buttons {\"OK\"} default button \"OK\""
    cleanup_and_exit 1
fi

# Prompt user for FFmpeg installation
USER_CHOICE=$(osascript -e "tell application \"System Events\" to display dialog \"Do you want to install FFmpeg?\" with title \"$TITLE\" buttons {\"No\", \"Yes\"} default button \"Yes\"")
if [[ $USER_CHOICE == *"Yes"* ]]; then
    echo "Starting installation..."

    chown "$USER" "$INSTALL_SCRIPT"
    chmod 755 "$INSTALL_SCRIPT"

    osascript -e "
    tell application \"Terminal\"
        if (count of windows) is 0 then reopen
        activate
        do script \"$INSTALL_SCRIPT; echo \$? > /tmp/install_exit_code; exit\" in first window
    end tell"

    echo "Waiting for FFmpeg installation to complete..."

    # Wait for the installation to finish by monitoring the exit code file
    while [[ ! -f /tmp/install_exit_code ]]; do sleep 1; done
    INSTALL_EXIT_CODE=$(cat /tmp/install_exit_code)

    # Remove the exit code file after reading it
    rm -f /tmp/install_exit_code

    # Check installation status and inform user
    if [[ $INSTALL_EXIT_CODE -eq 0 ]]; then
        echo "✅ FFmpeg installation was successful!"
        osascript -e "tell application \"System Events\" to display dialog \"FFmpeg installed successfully!\" with title \"$TITLE\" buttons {\"OK\"} default button \"OK\""
        cleanup_and_exit 0
    else
        echo "❌ FFmpeg installation failed!"
        osascript -e "tell application \"System Events\" to display dialog \"FFmpeg installation failed! Please check manually.\" with title \"$TITLE\" buttons {\"OK\"} default button \"OK\""
        cleanup_and_exit "$INSTALL_EXIT_CODE"
    fi

else
    echo "Skipping FFmpeg installation."
    cleanup_and_exit 0
fi
