post_install() {
    cat <<EOF > /usr/bin/frame-checker
#!/bin/sh
export QT_QPA_PLATFORM=xcb
export APP_ID=frame-checker
exec /opt/frame-checker/bin/frame-checker "\$@"
EOF

    chmod +x /usr/bin/frame-checker
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /usr/bin/frame-checker
}
